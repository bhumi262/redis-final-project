pipeline {
    agent any

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'main', url: 'https://github.com/bhumi262/redis-final-project.git'
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('terraform') {
                    sh 'terraform apply -auto-approve'
                }
            }
        }

        stage('Save EC2 IP') {
            steps {
                dir('terraform') {
                    sh 'terraform output -raw redis_server_public_ip > /tmp/redis_ip.txt'
                    sh 'echo "EC2 Public IP: $(cat /tmp/redis_ip.txt)"'
                }
            }
        }
    }

    post {
        success {
            echo 'Infra created successfully! Ready for Click 2 (Ansible deploy).'
        }
        failure {
            echo 'Terraform apply failed. Check logs above.'
        }
    }
}